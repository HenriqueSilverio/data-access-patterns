{
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "lib": ["es2025", "ESNext.Collection", "ESNext.Temporal"],
    "module": "nodenext",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "target": "esnext",
    "types": ["node"],
    "verbatimModuleSyntax": true
  }
}
